# SPDX-License-Identifier: MIT
# Fonto bull-board sidecar image. Express app that mounts the BullMQ admin
# UI behind HTTP Basic. Companion to Dockerfile.worker — same multi-stage
# layout, same `tsx` runtime, no compile step.
#
# Build:
#   docker build -f Dockerfile.bullboard -t fonto-bullboard:dev .
#
# Run (dev):
#   docker run --rm -p 3300:3300 --add-host=host.docker.internal:host-gateway \
#     -e REDIS_URL=redis://host.docker.internal:6379 \
#     -e BULL_BOARD_BASIC_AUTH_USER=ops \
#     -e BULL_BOARD_BASIC_AUTH_PASS=changeme \
#     fonto-bullboard:dev
#
# Prod: terminate TLS at Caddy, reverse-proxy to this container, keep the
# Basic creds in your secret manager.

FROM node:22-alpine AS base

FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN npm install -g pnpm@10
COPY package.json pnpm-lock.yaml ./
COPY pnpm-workspace.yaml ./
COPY packages ./packages
RUN pnpm install --frozen-lockfile

FROM base AS builder
WORKDIR /app
RUN npm install -g pnpm@10
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY . .
# No compile step — bull-board's TS sources are run directly via tsx, same
# pattern as the worker. Keeping the builder stage lets us prune dev deps
# in the final image while still carrying tsx (a dev dep that the runtime
# entrypoint requires).

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 bullboard
# The sidecar imports from lib/queue/, lib/logger.ts, lib/db (transitively).
# Copy the full lib/ tree + packages workspace for the bullmq imports.
COPY --from=builder --chown=bullboard:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=bullboard:nodejs /app/lib ./lib
COPY --from=builder --chown=bullboard:nodejs /app/bullboard ./bullboard
COPY --from=builder --chown=bullboard:nodejs /app/packages ./packages
COPY --from=builder --chown=bullboard:nodejs /app/package.json ./package.json
COPY --from=builder --chown=bullboard:nodejs /app/tsconfig.json ./tsconfig.json
USER bullboard
ENV BULL_BOARD_PORT=3300
EXPOSE 3300
CMD ["node_modules/.bin/tsx", "bullboard/index.ts"]
