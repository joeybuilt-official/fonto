# SPDX-License-Identifier: MIT
# Example environment for docker-compose.yml.
#
#   cp docker-compose.example.env .env
#   chmod 600 .env            # it will hold real secrets
#   $EDITOR .env              # fill in EVERY value marked REQUIRED below
#   docker compose up -d
#
# Compose reads `.env` from the project directory automatically. Every value
# marked REQUIRED has NO usable default — compose refuses to start the affected
# service (`${VAR:?message}`) rather than booting something insecure.
#
# Generate secrets with:
#   openssl rand -hex 32      # AUTH_SECRET, SHARE_LINK_IP_SALT, CRON_SECRET, METRICS_BEARER_TOKEN
#   openssl rand -hex 24      # BULL_BOARD_BASIC_AUTH_PASS
#   openssl rand -hex 16      # POSTGRES_PASSWORD, REDIS_PASSWORD, MINIO_ROOT_PASSWORD
#
# `.env` is gitignored (see .gitignore `!.env.example`). Never commit your copy.

# ── Database ──────────────────────────────────────────────────────────────
# REQUIRED. Postgres runs in the `postgres` service as user/db below.
POSTGRES_PASSWORD=
POSTGRES_USER=fonto
POSTGRES_DB=fonto

# ── Queue (Valkey) ────────────────────────────────────────────────────────
# REQUIRED. BullMQ keeps all queue state here, so the compose file runs Valkey
# with maxmemory-policy noeviction — evicting a key would lose jobs.
REDIS_PASSWORD=

# ── Object storage (MinIO in compose, or bring your own S3/R2) ──────────
# REQUIRED. MinIO's root credentials double as the S3 access key pair.
MINIO_ROOT_USER=fonto
MINIO_ROOT_PASSWORD=
# These two are what the app actually reads. Leave them pointed at the compose
# MinIO by default (the anchor in docker-compose.yml derives them from the two
# variables above when unset).
#R2_ACCESS_KEY_ID=fonto
#R2_SECRET_ACCESS_KEY=<the same value as MINIO_ROOT_PASSWORD above>
R2_BUCKET=fonto-assets

# R2_ENDPOINT is used BOTH server-side and to build the presigned URLs handed to
# the BROWSER (there is only one endpoint variable — see the warning in
# docker-compose.yml). The compose-internal default works only for a
# single-host install you browse via localhost:
#R2_ENDPOINT=http://minio:9000
#
# Browsers on other machines need a reachable address instead, with minio's port
# published (uncomment the `ports:` block on the minio service):
#R2_ENDPOINT=http://192.168.1.50:9000
#R2_ENDPOINT=https://objects.example.com
#
# Using Cloudflare R2 or AWS S3 instead of MinIO? Point these at it and the
# `minio`/`minio-init` services simply go unused:
#R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#S3_FORCE_PATH_STYLE=false

# ── Identity / secrets ────────────────────────────────────────────────────
# REQUIRED. Better Auth session signing secret.
AUTH_SECRET=

# REQUIRED. Per-deploy salt for share-link IP hashing. hashIp() THROWS in
# production without it, because the fallback constant is public in this repo
# and would make every stored ipHash recoverable.
SHARE_LINK_IP_SALT=

# ── Public origin ─────────────────────────────────────────────────────────
# A BUILD arg (Next.js inlines NEXT_PUBLIC_* at compile time). After changing
# it you must rebuild, not just restart:
#   docker compose build fonto && docker compose up -d fonto
NEXT_PUBLIC_APP_URL=http://localhost:3500
#BETTER_AUTH_URL=https://fonto.example.com

# WebAuthn relying-party id. When unset, lib/auth/passkey.ts derives it from
# PASSKEY_ORIGIN / BETTER_AUTH_URL / NEXT_PUBLIC_APP_URL, falling back to
# "localhost". The rpId is stored inside every registered credential: changing
# it later forces all users to re-register their passkeys.
#PASSKEY_RP_ID=fonto.example.com
# WebAuthn origin. Derived as https://<rpId> when unset.
#PASSKEY_ORIGIN=https://fonto.example.com

# ── Access control ────────────────────────────────────────────────────────
# Registration is INVITE-ONLY by default (lib/auth.ts): the first-ever user on a
# fresh instance is allowed so you can bootstrap, and after that only invited
# emails may register. Set "true" only for a genuinely open instance.
FONTO_ALLOW_OPEN_SIGNUP=false
# Comma-separated emails that sit ABOVE workspace ownership (server stats,
# user management). Unset ⇒ the tier does not exist (fail-closed).
#FONTO_INSTANCE_ADMINS=you@example.com

# ── Bind addresses ────────────────────────────────────────────────────────
# Loopback by default: put a TLS proxy in front (the `selfhosted` profile runs
# Caddy). Change the bind to 0.0.0.0 only if this box is intentionally public.
FONTOWEB_BIND=127.0.0.1
FONTOWEB_PORT=3500

# ── Build ─────────────────────────────────────────────────────────────────
# `next build` OOMs below ~4096 MB (exit 134). Raise to 6144 on a host with the
# RAM; do not lower it.
NODE_HEAP_MB=4096

# ── Worker ────────────────────────────────────────────────────────────────
#WORKER_CONCURRENCY=4
#THUMBNAIL_WORKER_CONCURRENCY=2
# Local-mirror storage root. Unset ⇒ the local-fs mirror paths are skipped and
# originals live only in the object store (storage policy `r2_only`). To put
# originals on your own disk, bind-mount a host directory into BOTH `fonto` and
# `fonto-worker` at this same path and set it:
#LOCAL_STORAGE_ROOT=/data/fonto-media

# ── AI (all optional; unset ⇒ those features no-op, uploads/search still work) ─
# FONTO_LLM_* is the ONLY AI path that needs no Plexo deployment.
#FONTO_LLM_KEY=sk-ant-...
#FONTO_LLM_BASE_URL=https://api.anthropic.com
# Vision sidecar (OCR, CLIP embeddings, face detection). FONTO_VISION_URL is
# preferred over PLEXO_VISION_URL.
#FONTO_VISION_URL=http://plexo-vision:7000
# Legacy alias for the same sidecar; FONTO_VISION_URL wins when both are set.
#PLEXO_VISION_URL=http://plexo-vision:7000
# Or route through a Plexo Core deployment:
#PLEXO_URL=http://plexo-core:3000
#PLEXO_SERVICE_KEY=plexo_sk_...

# ── Cron / metrics / email (optional) ─────────────────────────────────────
#CRON_SECRET=
# Verbosity: debug | info | warn | error. Default "info".
#LOG_LEVEL=info
#METRICS_BEARER_TOKEN=
# Transactional email (invitations, password reset). EMAIL_FROM should be a
# domain you have verified with your provider — Resend rejects an unverified
# From address, so leaving EMAIL_FROM unset means delivery fails.
#RESEND_API_KEY=re_...
#EMAIL_FROM="Fonto <noreply@your-domain.example>"

# ── SSO / OAuth (optional) ────────────────────────────────────────────────
# Generic OIDC. All three must be set or the plugin stays unmounted and
# email+password is the only sign-in path. Register this callback at your IdP:
#   <NEXT_PUBLIC_APP_URL>/api/auth/oauth2/callback/<OIDC_PROVIDER_ID>
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_DISCOVERY_URL=
#OIDC_PROVIDER_ID=sso
# Google Drive / Photos import. Register this redirect URI in the Google Cloud
# console: <NEXT_PUBLIC_APP_URL>/api/v1/integrations/google/callback
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=

# ── Profile: bullboard (queue admin UI, loopback-only) ────────────────────
# Both are REQUIRED — bullboard/index.ts exits(1) without them.
#BULL_BOARD_BASIC_AUTH_USER=ops
#BULL_BOARD_BASIC_AUTH_PASS=
#BULL_BOARD_PORT=3300

# ── Profile: autoscaler (docker socket; DRY RUN by default) ───────────────
#AUTOSCALER_DRY_RUN=1

# ── Profile: backup (pg_dump sidecar) ─────────────────────────────────────
# REQUIRED for this profile — the sidecar's own DB password (same value as
# POSTGRES_PASSWORD; it authenticates as POSTGRES_USER).
#PGPASSWORD=
#BACKUP_RETENTION_DAYS=7
#BACKUP_INTERVAL_SECONDS=86400

# ── Profile: selfhosted (Caddy TLS) ───────────────────────────────────────
# Must be the bare host that NEXT_PUBLIC_APP_URL points at, and it must resolve
# to this host with ports 80/443 reachable for certificate issuance.
#PUBLIC_DOMAIN=fonto.example.com

# ── Profile: observability ────────────────────────────────────────────────
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=
# Directory holding alertmanager's file-per-key secrets (Discord webhook URL,
# SMTP creds), chmod 600. Defaults to ./ops/secrets.
#ALERTMANAGER_SECRETS_DIR=<host-path>/secrets/alertmanager
