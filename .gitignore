# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# serena MCP local config (per-developer)
/.serena/

# FUSE leftover temp files (the dev fs is FUSE-backed; the kernel
# leaves these behind when a file is replaced while another process
# has it open). Not real artifacts — never commit.
.fuse_hidden*

# Playwright
/e2e/.auth/
/playwright-report/
/test-results/

# Claude local configuration
.claude/settings.local.json
CLAUDE.local.md
